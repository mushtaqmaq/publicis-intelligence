# Names only. Never commit real values.

# Database: Postgres connection string (Neon). PI_DB_DATABASE_URL wins; DATABASE_URL is the fallback for local runs.
PI_DB_DATABASE_URL=
DATABASE_URL=

# First admin sign-in (created on first start)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_START_CREDITS=
RESET_ADMIN_PASSWORD=

# AI providers
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
REPLICATE_API_TOKEN=
REPLICATE_BASE_URL=
AI_API_KEY=
AI_BASE_URL=
HF_TOKEN=
HF_BASE_URL=
IMAGE_API_KEY=
IMAGE_URL=

# SEO data
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=

# Optional web search
TAVILY_API_KEY=
TAVILY_URL=
BRAVE_API_KEY=
SEARXNG_URL=

# Geo Intelligence (Media). Server key: server-side only; enable Places API (New), Places Aggregate, Geocoding and Routes for it.
GOOGLE_MAPS_API_KEY=
# Browser-side map only. Restrict by HTTP referrer (https://publicis-intelligence.vercel.app/*) and to Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=

# Google cost guardrails (defaults shown; see docs/geo/google-billing-policy.md). Only change these deliberately.
# GEO_GOOGLE_GLOBAL_UNIT_LIMIT=5000
# GEO_GOOGLE_ESSENTIALS_SKU_LIMIT=4500
# GEO_GOOGLE_PRO_SKU_LIMIT=4000
# GEO_GOOGLE_ENTERPRISE_SKU_LIMIT=750
# GEO_GOOGLE_DYNAMIC_MAP_LIMIT=5000
# GEO_GOOGLE_ENTERPRISE_FIELDS_ENABLED=false
# GEO_GOOGLE_ENABLED=true
# GEO_GOOGLE_MAPS_ENABLED=true
# GEO_GOOGLE_PLACES_ENABLED=true
# GEO_GOOGLE_ROUTES_ENABLED=true

# Optional, off by default. 1 = also store names, ratings, opening hours, place details and route times for 30 days so repeats never
# call Google. Google's terms allow storing only place ids and coordinates, so turning this on is the operator's own decision.
GEO_CACHE_FULL_RESPONSES=

# Local server only
PORT=7860
