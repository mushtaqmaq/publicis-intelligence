{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": false,
  "functions": {
    "api/[...path].js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/files/:path*", "destination": "/api/files/:path*" },
    { "source": "/login", "destination": "/login.html" }
  ]
}
