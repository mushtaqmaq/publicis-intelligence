{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://publicis-intelligence-api.fly.dev/api/:path*" },
    { "source": "/files/:path*", "destination": "https://publicis-intelligence-api.fly.dev/files/:path*" },
    { "source": "/login", "destination": "/login.html" }
  ]
}
