{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-ME.invalid/api/:path*" },
    { "source": "/files/:path*", "destination": "https://REPLACE-ME.invalid/files/:path*" },
    { "source": "/login", "destination": "/login.html" }
  ]
}
