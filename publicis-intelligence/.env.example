# Any OpenAI-compatible endpoint.
# OpenRouter (one key for Claude, GPT, Gemini, Perplexity, Llama, Qwen, DeepSeek and more):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-key-here

# Pick model ids from your provider's model list (for OpenRouter: openrouter.ai/models).
MODEL_QUICK=
MODEL_DEFAULT=
MODEL_COMPLEX=
# Optional: live-web research model for the Research and Competitor agents (e.g. a Perplexity Sonar model)
MODEL_RESEARCH=
# Optional: a separate model for all Creative agents
MODEL_CREATIVE=

# Protect the app. Everyone signs in with these.
APP_USER=publicis
APP_PASSWORD=change-me

MAX_TOKENS=8000
PORT=7860
DATA_DIR=./data
